# Среда приложения: local, demo, staging или production.
APP_ENV=local

# Force UTF-8 for Python stdio and process locale.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
LANG=C.UTF-8
LC_ALL=C.UTF-8

# Включает автоматическое создание демо-организации, пользователей и демо-публикаций.
DEMO_MODE=true

# Логин демо-аналитика для входа в UI.
DEMO_USER_LOGIN=demo

# Пароль демо-аналитика для входа в UI.
DEMO_USER_PASSWORD=demo12345

# Логин демо-администратора.
DEMO_ADMIN_LOGIN=admin

# Пароль демо-администратора.
DEMO_ADMIN_PASSWORD=admin12345

# Начальный баланс демо-организации в кредитах.
DEMO_INITIAL_CREDIT=100000.00

# CSV-файл, который API импортирует при старте demo-mode.
DEMO_NEWS_PATH=data/demo/lenta_demo.csv

# Имя базы PostgreSQL.
POSTGRES_DB=semantic_news_novelty

# Пользователь PostgreSQL.
POSTGRES_USER=semantic_news_novelty

# Пароль PostgreSQL; для публичного стенда обязательно замените.
POSTGRES_PASSWORD=change_me_postgres

# Хост PostgreSQL внутри сети Docker Compose.
POSTGRES_HOST=postgres

# Порт PostgreSQL внутри сети Docker Compose.
POSTGRES_PORT=5432

# Пользователь RabbitMQ.
RABBITMQ_USER=semantic_news_novelty

# Пароль RabbitMQ; для публичного стенда обязательно замените.
RABBITMQ_PASSWORD=change_me_rabbitmq

# Хост RabbitMQ внутри сети Docker Compose.
RABBITMQ_HOST=rabbitmq

# AMQP-порт RabbitMQ внутри сети Docker Compose.
RABBITMQ_PORT=5672

# Виртуальный хост RabbitMQ.
RABBITMQ_VHOST=/

# Внешний порт панели RabbitMQ Management.
RABBITMQ_MANAGEMENT_PORT=15672

# Число GPU-векторизаторов model-service.
MODEL_SERVICE_VECTORIZER_GPU_REPLICAS=1

# Число CPU-векторизаторов model-service; поставьте 1, если видеокарта недоступна.
MODEL_SERVICE_VECTORIZER_CPU_REPLICAS=0

# Число CPU-процессоров, выполняющих этапы агрегации и оценки новизны.
MODEL_SERVICE_PROCESSOR_REPLICAS=1

# Устройство PyTorch для GPU-векторизатора.
MODEL_SERVICE_VECTORIZER_GPU_DEVICE=cuda

# Устройство PyTorch для CPU-векторизатора.
MODEL_SERVICE_VECTORIZER_CPU_DEVICE=cpu

# RabbitMQ-очередь задач векторизации.
NEWS_VECTORIZATION_QUEUE=news_vectorization.jobs

# RabbitMQ-очередь задач кластеризации и оценки новизны.
NEWS_AGGREGATION_QUEUE=news_aggregation.jobs

# Размер пачки публикаций для стадии vectorize.
PIPELINE_CHUNK_SIZE=5000

# Размер пачки публикаций для стадии aggregate.
PIPELINE_AGGREGATE_BATCH_SIZE=5000

# Окно истории в днях вокруг новых публикаций для incremental/aggregate.
PIPELINE_HISTORY_WINDOW_DAYS=30

# Расширять ли историю до целых уже известных кластеров.
PIPELINE_HISTORY_EXPAND_CLUSTERS=true

# Максимум строк истории после расширения кластеров.
PIPELINE_HISTORY_CLUSTER_EXPANSION_MAX_ROWS=20000

# Максимальный размер файла импорта в MiB.
NEWS_IMPORT_MAX_FILE_MIB=512

# Максимальное число строк в одном файле импорта.
NEWS_IMPORT_MAX_ROWS=1000000

# Таймаут upload-запроса UI при импорте больших файлов.
NEWS_IMPORT_UPLOAD_TIMEOUT_SECONDS=900

# Порог cosine similarity для строгого baseline-графа.
PIPELINE_BASE_STORY_THRESHOLD=0.82

# Временное окно baseline-графа в днях.
PIPELINE_BASE_STORY_WINDOW_DAYS=14

# Минимальная similarity для второго прохода attach.
PIPELINE_ATTACH_MIN_SIMILARITY=0.75

# Максимальный разрыв по времени для attach-кандидатов в днях.
PIPELINE_ATTACH_MAX_DAYS=7

# Минимальный отрыв лучшего attach-кандидата от второго.
PIPELINE_ATTACH_MIN_MARGIN=0.03

# Максимальный размер source-кластера, который можно присоединять.
PIPELINE_ATTACH_SOURCE_MAX_CLUSTER_SIZE=2

# Минимальный Jaccard заголовков для evidence-aware attach.
PIPELINE_ATTACH_TITLE_JACCARD_THRESHOLD=0.15

# Минимальное число общих числовых фактов для evidence-aware attach.
PIPELINE_ATTACH_MIN_SHARED_NUMBERS=1

# Требовать ли текстовые/числовые evidence для attach.
PIPELINE_ATTACH_REQUIRE_EVIDENCE=true

# Включает SQLAlchemy echo для отладки SQL.
SQLALCHEMY_ECHO=false

# Секретная добавка для PBKDF2-хеширования паролей; замените перед демонстрацией вне localhost.
PASSWORD_HASH_SECRET=change_me_password_hash_secret

# Секрет для HMAC-подписи токенов доступа; замените перед демонстрацией вне localhost.
ACCESS_TOKEN_SECRET=change_me_access_token_secret

# Время жизни токена доступа в минутах.
ACCESS_TOKEN_TTL_MINUTES=1440

# Стоимость публикации одной новости в кредитах.
NEWS_ADD_COST=1.00

# Стоимость одного семантического поиска в кредитах.
NEWS_SEARCH_COST=0.00

# Какие NVIDIA GPU видны контейнеру.
NVIDIA_VISIBLE_DEVICES=all

# Возможности NVIDIA runtime, необходимые PyTorch и nvidia-smi.
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Базовый CUDA/PyTorch образ для GPU-векторизатора.
PYTORCH_IMAGE=mirror.gcr.io/pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# Путь Hugging Face cache внутри контейнера.
MODEL_SERVICE_HF_HOME=/app/.cache/huggingface

# Docker volume или путь на хосте для кеша Hugging Face.
MODEL_SERVICE_HF_CACHE=model_cache

# Отключает Xet-загрузку Hugging Face Hub и использует обычный HTTP-механизм.
HF_HUB_DISABLE_XET=1

# Необязательный токен Hugging Face для приватных моделей или повышенных лимитов.
HF_TOKEN=

# Внешний HTTP-порт nginx.
NGINX_PORT=80

# Внешний порт Grafana.
GRAFANA_PORT=3000

# Логин администратора Grafana.
GRAFANA_ADMIN_USER=admin

# Пароль администратора Grafana; замените перед публичным показом.
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# Внешний порт Prometheus.
PROMETHEUS_PORT=9090

# Срок хранения метрик Prometheus.
PROMETHEUS_RETENTION=15d
